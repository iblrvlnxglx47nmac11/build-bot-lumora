{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "lumora-ext/Dockerfile"
  },
  "deploy": {
    "startCommand": "node headless-bot.js",
    "restartPolicyMaxRetries": 10,
    "restartPolicyWindowMs": 120000,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
